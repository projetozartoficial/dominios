# Copie este arquivo para ".env" e preencha.
# O arquivo .env NUNCA deve ir para o GitHub (ele já está no .gitignore).

# Porta do servidor
PORTA=8080

# Endereço do seu site (só ele pode usar a API). Ex.: https://seudominio.com.br
ORIGEM_PERMITIDA=http://localhost:8000

# Chave da API do provedor de revenda (Dynadot, GoDaddy...)
PROVEDOR_CHAVE_API=

# Chave do serviço de pagamento (Mercado Pago, Stripe...)
PAGAMENTO_CHAVE_API=
