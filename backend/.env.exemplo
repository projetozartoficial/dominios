# Copie este arquivo para ".env" e preencha.
# O arquivo .env NUNCA deve ir para o GitHub (ele já está no .gitignore).
# No Render, essas mesmas chaves vão em "Environment" (não precisa do arquivo).

# ---------- Endereços ----------
# Endereço do site (o GitHub Pages ou o seu domínio). Só ele pode usar a API.
ORIGEM_PERMITIDA=https://projetozartoficial.github.io
# Endereço completo do site, com a pasta (usado nos links de volta do pagamento)
URL_SITE=https://projetozartoficial.github.io/dominios
# Endereço público deste back-end (o que o Render mostrar depois do deploy)
URL_API=https://zart-dominios-api.onrender.com

# ---------- Dynadot (registro dos domínios) ----------
# Dynadot > Tools > API. Comece com o modo teste ligado.
DYNADOT_CHAVE_API=
DYNADOT_MODO_TESTE=sim

# ---------- Mercado Pago (pagamento) ----------
# Suas integrações > sua aplicação > Credenciais de produção > Access Token
MERCADOPAGO_ACCESS_TOKEN=
# Suas integrações > sua aplicação > Webhooks > Assinatura secreta
MERCADOPAGO_SEGREDO_WEBHOOK=

# ---------- E-mail (SMTP) ----------
# Exemplo Gmail: smtp.gmail.com, porta 587, e uma "senha de app"
SMTP_SERVIDOR=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
# Para onde vão os avisos de venda e de contato
EMAIL_ADMIN=

# ---------- Dados ----------
# Pasta do banco de dados. No Render, aponte para o disco persistente (ex.: /var/data)
PASTA_DADOS=
